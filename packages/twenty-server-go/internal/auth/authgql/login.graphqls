type TwoFactorAuthenticationRecoveryCodeRedemption {
  tokens: AuthTokenPair
  provisioningUri: String
}

extend type Mutation {
  getAuthTokensFromOTP(loginToken: String!, otp: String!, captchaToken: String, origin: String!): AuthTokens!
  getAuthTokensFromTwoFactorAuthenticationRecoveryCode(loginToken: String!, recoveryCode: String!, captchaToken: String, origin: String!): TwoFactorAuthenticationRecoveryCodeRedemption!
}
