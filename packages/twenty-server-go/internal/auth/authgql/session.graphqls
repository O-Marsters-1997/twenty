type AuthToken {
  token: String!
  expiresAt: DateTime!
}

type AuthTokenPair {
  accessOrWorkspaceAgnosticToken: AuthToken!
  refreshToken: AuthToken!
}

type AuthTokens {
  tokens: AuthTokenPair!
}

extend type Mutation {
  getAuthTokensFromLoginToken(loginToken: String!, origin: String!): AuthTokens!
  renewToken(appToken: String!): AuthTokens!
  signOut(refreshToken: String): Boolean!
}

type UserSession {
  id: UUID!
  workspaceId: UUID
  authProvider: String!
  userAgent: String
  ipAddress: String
  createdAt: DateTime!
  lastActiveAt: DateTime!
  expiresAt: DateTime!
  isCurrent: Boolean!
}

type TransientToken {
  transientToken: AuthToken!
}

extend type Query {
  currentUserSessions: [UserSession!]!
}

extend type Mutation {
  revokeUserSession(userSessionId: UUID!): Boolean!
  revokeAllOtherUserSessions: Int!
  generateTransientToken: TransientToken!
}
