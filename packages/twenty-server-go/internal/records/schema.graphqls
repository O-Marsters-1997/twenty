  IN_PROGRESS
  DONE
}

type TaskTarget {
  createdAt: DateTime!
  createdBy: Actor!
  deletedAt: DateTime
  id: UUID!
  position: Position!
  searchVector: TSVector
  targetCompanyId: ID
  targetCompany: Company
  targetOpportunityId: ID
  targetOpportunity: Opportunity
  targetPersonId: ID
  targetPerson: Person
  taskId: ID
  task: Task
  updatedAt: DateTime!
  updatedBy: Actor!
}

type TaskTargetEdge {
  node: TaskTarget!
  cursor: Cursor!
}

type TaskTargetConnection {
  totalCount: Int
  edges: [TaskTargetEdge!]!
  pageInfo: PageInfo!
}

