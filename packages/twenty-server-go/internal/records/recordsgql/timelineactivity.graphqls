extend type Query {
  timelineActivities(filter: TimelineActivityFilterInput, orderBy: [TimelineActivityOrderByInput], first: Int, last: Int, after: String, before: String, offset: Int): TimelineActivityConnection!
  timelineActivity(filter: TimelineActivityFilterInput): TimelineActivity
  timelineActivitiesGroupBy(groupBy: [TimelineActivityGroupByInput!]!, filter: TimelineActivityFilterInput, orderBy: [TimelineActivityOrderByWithGroupByInput!], orderByForRecords: [TimelineActivityOrderByInput!], viewId: UUID, limit: Int, offsetForRecords: Int): [TimelineActivityGroupByConnection!]!
}

extend type Mutation {
  createTimelineActivity(data: TimelineActivityCreateInput): TimelineActivity
  createTimelineActivities(data: [TimelineActivityCreateInput!]!, upsert: Boolean): [TimelineActivity!]
  updateTimelineActivity(id: UUID!, data: TimelineActivityUpdateInput!): TimelineActivity
  updateTimelineActivities(filter: TimelineActivityFilterInput!, data: TimelineActivityUpdateInput!): [TimelineActivity!]
  deleteTimelineActivity(id: UUID!): TimelineActivity
  deleteTimelineActivities(filter: TimelineActivityFilterInput!): [TimelineActivity!]
  destroyTimelineActivity(id: UUID!): TimelineActivity
  destroyTimelineActivities(filter: TimelineActivityFilterInput!): [TimelineActivity!]
  restoreTimelineActivities(filter: TimelineActivityFilterInput!): [TimelineActivity!]
}
