input FullNameGroupByInput {
  firstName: Boolean
  lastName: Boolean
}

input PersonGroupByInput {
  name: FullNameGroupByInput
  jobTitle: Boolean
  avatarUrl: Boolean
  company: Boolean
}

input PersonOrderByWithGroupByInput {
  name: FullNameOrderByInput
  jobTitle: OrderByDirection
  avatarUrl: OrderByDirection
  company: OrderByDirection
}

extend type Query {
  peopleGroupBy(groupBy: [PersonGroupByInput!]!, filter: PersonFilterInput, orderBy: [PersonOrderByWithGroupByInput!], orderByForRecords: [PersonOrderByInput!], viewId: UUID, limit: Int, offsetForRecords: Int): [PersonGroupByConnection!]!
