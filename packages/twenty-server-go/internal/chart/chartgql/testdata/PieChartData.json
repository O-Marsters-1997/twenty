  "variables": {
    "input": {
      "objectMetadataId": "o-opportunity",
      "configuration": {
        "configurationType": "PIE_CHART",
        "aggregateFieldMetadataId": "f-id",
        "aggregateOperation": "COUNT",
        "groupByFieldMetadataId": "f-stage"
      }
    }
  },
  "response": {
    "data": {
      "pieChartData": {
        "data": [{"key": "New", "value": 3}, {"key": "Won", "value": 2}],
        "showLegend": true,
        "showDataLabels": false,
        "showCenterMetric": false,
        "hasTooManyGroups": false,
        "formattedToRawLookup": {"New": "NEW", "Won": "WON"}
      }
    }
  }
}
