{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "watchOptions": {
    "ignored": [
      "**/node_modules/**",
      "**/dist/**",
      "**/.git/**",
      "**/.nx/**",
      "**/.local-storage/**"
    ]
  },
  "compilerOptions": {
    "builder": "swc",
    "typeCheck": false,
    "watchAssets": true,
    "assets": [
      {
        "include": "engine/core-modules/application/application-package/constants/seed-dependencies/**",
        "outDir": "dist/assets"
      },
      {
        "include": "database/clickhouse/migrations/*.sql",
        "outDir": "dist"
      },
      {
        "include": "engine/workspace-manager/dev-seeder/data/sample-files/**",
        "outDir": "dist/assets"
      },
      {
        "include": "engine/metadata-modules/ai/ai-models/ai-providers.json",
        "outDir": "dist"
      },
      {
        "include": "engine/core-modules/dpa/constants/subprocessors.json",
        "outDir": "dist"
      }
    ]
  },
  "monorepo": false,
  "root": "src"
}
