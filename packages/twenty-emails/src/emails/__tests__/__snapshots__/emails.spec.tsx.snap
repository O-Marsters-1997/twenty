  </style></head><!--$--><!--html--><!--head--><table align="center" width="290" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:37.5em"><tbody><tr style="width:100%"><td><img alt="Twenty logo" height="40" src="https://app.twenty.com/images/icons/windows11/Square150x150Logo.scale-100.png" style="display:block;outline:none;border:none;text-decoration:none;margin-bottom:40px" width="40"/><h1 style="font-family:Trebuchet MS;font-size:24px;line-height:normal;font-weight:600;color:rgb(51,51,51)">Reset your password 🗝</h1><p style="font-size:13px;line-height:20px;font-family:Trebuchet MS;font-weight:400;color:rgb(102,102,102);margin-top:16px;margin-bottom:16px">This link is only valid for the next 24 hours. If the link does not work, you can use the login verification link directly:<br/><a href="https://app.twenty.com/reset-password/123" style="color:rgb(179,179,179);text-decoration-line:underline" target="_blank">https://app.twenty.com/reset-password/123</a></p><br/><a href="https://app.twenty.com/reset-password/123" style="line-height:100%;text-decoration:none;display:inline-flex;max-width:100%;mso-padding-alt:0px;width:auto;border-radius:8px;border-style:solid;border-width:1px;border-color:rgb(0,0,0,0.04);background-color:rgb(51,51,51);padding-right:32px;padding-left:32px;padding-bottom:8px;padding-top:8px;font-size:13px;font-weight:600;color:rgb(255,255,255);box-shadow:0px 2px 4px 0px rgb(0,0,0,0.04),0px 0px 4px 0px rgb(0,0,0,0.08)" target="_blank"><span><!--[if mso]><i style="mso-font-width:400%;mso-text-raise:12px" hidden>&#8202;&#8202;&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:6px">Reset</span><span><!--[if mso]><i style="mso-font-width:400%" hidden>&#8202;&#8202;&#8202;&#8202;&#8203;</i><![endif]--></span></a><br/><br/><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:37.5em;margin-top:12px"><tbody><tr style="width:100%"><td><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation"><tbody style="width:100%"><tr style="width:100%"><td data-id="__react-email-column"><p style="font-size:12px;line-height:20px;margin:0;margin-bottom:12px;font-weight:400;color:rgb(179,179,179);margin-top:0;margin-left:0;margin-right:0"><a href="https://twenty.com/" style="color:rgb(179,179,179);text-decoration-line:underline" target="_blank">Website</a></p></td><td data-id="__react-email-column"><p style="font-size:12px;line-height:20px;margin:0;margin-bottom:12px;font-weight:400;color:rgb(179,179,179);margin-top:0;margin-left:0;margin-right:0"><a href="https://github.com/twentyhq/twenty" style="color:rgb(179,179,179);text-decoration-line:underline" target="_blank">Github</a></p></td><td data-id="__react-email-column"><p style="font-size:12px;line-height:20px;margin:0;margin-bottom:12px;font-weight:400;color:rgb(179,179,179);margin-top:0;margin-left:0;margin-right:0"><a href="https://docs.twenty.com/getting-started/introduction" style="color:rgb(179,179,179);text-decoration-line:underline" target="_blank">User guide</a></p></td><td data-id="__react-email-column"><p style="font-size:12px;line-height:20px;margin:0;margin-bottom:12px;font-weight:400;color:rgb(179,179,179);margin-top:0;margin-left:0;margin-right:0"><a href="https://docs.twenty.com/" style="color:rgb(179,179,179);text-decoration-line:underline" target="_blank">Developers</a></p></td></tr></tbody></table><p style="font-size:12px;line-height:20px;margin:0;margin-bottom:12px;font-weight:400;color:rgb(179,179,179);margin-top:0;margin-left:0;margin-right:0">Twenty.com, Public Benefit Corporation<br/>San Francisco / Paris</p></td></tr></tbody></table></td></tr></tbody></table><!--/$--></html>"
`;

