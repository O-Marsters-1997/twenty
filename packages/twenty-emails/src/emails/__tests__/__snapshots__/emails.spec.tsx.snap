padding-bottom:4px;padding-top:4px;font-weight:600;color:rgb(51,51,51);margin-top:16px;margin-bottom:16px">Acme Inc.</p></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation"><tbody style="width:100%"><tr style="width:100%"><td align="center" data-id="__react-email-column"><a href="https://app.twenty.com/invite/123" style="line-height:100%;text-decoration:none;display:inline-flex;max-width:100%;mso-padding-alt:0px;width:auto;border-radius:8px;border-style:solid;border-width:1px;border-color:rgb(0,0,0,0.04);background-color:rgb(51,51,51);padding-right:32px;padding-left:32px;padding-bottom:8px;padding-top:8px;font-size:13px;font-weight:600;color:rgb(255,255,255);box-shadow:0px 2px 4px 0px rgb(0,0,0,0.04),0px 0px 4px 0px rgb(0,0,0,0.08)" target="_blank"><span><!--[if mso]><i style="mso-font-width:400%;mso-text-raise:12px" hidden>&#8202;&#8202;&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:6px">Accept invite</span><span><!--[if mso]><i style="mso-font-width:400%" hidden>&#8202;&#8202;&#8202;&#8202;&#8203;</i><![endif]--></span></a></td></tr></tbody></table></td></tr></tbody></table><h3 style="font-family:Trebuchet MS;font-size:16px;line-height:normal;font-weight:600;color:rgb(51,51,51)">What is Twenty?</h3><p style="font-size:13px;line-height:20px;font-family:Trebuchet MS;font-weight:400;color:rgb(102,102,102);margin-top:16px;margin-bottom:16px">It&#x27;s a CRM, a software to help businesses manage their customer data and relationships efficiently.</p><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:37.5em;margin-top:12px"><tbody><tr style="width:100%"><td><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation"><tbody style="width:100%"><tr style="width:100%"><td data-id="__react-email-column"><p style="fon