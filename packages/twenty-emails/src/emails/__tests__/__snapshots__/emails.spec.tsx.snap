sentation"><tbody style="width:100%"><tr style="width:100%"><td data-id="__react-email-column"><p style="font-size:12px;line-height:20px;margin:0;margin-bottom:12px;font-weight:400;color:rgb(179,179,179);margin-top:0;margin-left:0;margin-right:0"><a href="https://twenty.com/" style="color:rgb(179,179,179);text-decoration-line:underline" target="_blank">Website</a></p></td><td data-id="__react-email-column"><p style="font-size:12px;line-height:20px;margin:0;margin-bottom:12px;font-weight:400;color:rgb(179,179,179);margin-top:0;margin-left:0;margin-right:0"><a href="https://github.com/twentyhq/twenty" style="color:rgb(179,179,179);text-decoration-line:underline" target="_blank">Github</a></p></td><td data-id="__react-email-column"><p style="font-size:12px;line-height:20px;margin:0;margin-bottom:12px;font-weight:400;color:rgb(179,179,179);margin-top:0;margin-left:0;margin-right:0"><a href="https://docs.twenty.com/getting-started/introduction" style="color:rgb(179,179,179);text-decoration-line:underline" target="_blank">User guide</a></p></td><td data-id="__react-email-column"><p style="font-size:12px;line-height:20px;margin:0;margin-bottom:12px;font-weight:400;color:rgb(179,179,179);margin-top:0;margin-left:0;margin-right:0"><a href="https://docs.twenty.com/" style="color:rgb(179,179,179);text-decoration-line:underline" target="_blank">Developers</a></p></td></tr></tbody></table><p style="font-size:12px;line-height:20px;margin:0;margin-bottom:12px;font-weight:400;color:rgb(179,179,179);margin-top:0;margin-left:0;margin-right:0">Twenty.com, Public Benefit Corporation<br/>San Francisco / Paris</p></td></tr></tbody></table></td></tr></tbody></table><!--/$--></html>"
