{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "binaries": "warn",
    "dependencies": "error",
    "devDependencies": "error",
    "duplicates": "warn",
    "enumMembers": "warn",
    "exports": "warn",
    "files": "error",
    "optionalPeerDependencies": "warn",
    "types": "warn",
    "unlisted": "warn",
    "unresolved": "warn"
  },
  "workspaces": {
    "packages/twenty-front": {
      "vite": true,
      "vitest": true,
      "entry": [
        "src/index.tsx",
        "src/**/graphql/**/*.{ts,tsx}",
        "src/modules/geo-map/graphql-query/*.{ts,tsx}",
        "vitest.config.ts",
        "lingui.config.ts",
        "nyc.config.cjs",
        "jest-failures-only-reporter.cjs"
      ],
      "graphql-codegen": [
        "codegen.cjs",
        "codegen-admin.cjs",
        "codegen-metadata.cjs"
      ],
      "ignore": ["src/locales/generated/**", ".eloqnt/config.ts"],
      "ignoreDependencies": [
        "@babel/preset-typescript",
        "buffer",
        "esbuild",
        "playwright",
        "rollup-plugin-node-polyfills"
      ]
    },
    "packages/twenty-ui": {
      "entry": ["scripts/**/*.ts", "docs/**/*.ts"],
      "ignoreDependencies": ["@swc/core"]
    }
  }
}
